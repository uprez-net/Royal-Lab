{
  "name": "royal-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.1.2",
  "imports": {
    "#tui": {
      "development": "./src/tui.tsx",
      "default": "./dist/tui.js"
    },
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#contracts/*": {
      "development": "./src/contracts/*.ts",
      "default": "./dist/contracts/*.js"
    },
    "#tasks/*": {
      "development": "./src/tasks/*.ts",
      "default": "./dist/tasks/*.js"
    },
    "#fixtures/*": {
      "development": "./src/fixtures/*.ts",
      "default": "./dist/fixtures/*.js"
    },
    "#runs/*": {
      "development": "./src/runs/*.ts",
      "default": "./dist/runs/*.js"
    },
    "#reporting/*": {
      "development": "./src/reporting/*.ts",
      "default": "./dist/reporting/*.js"
    }
  },
  "scripts": {
    "lab": "node --conditions=development --import tsx src/cli.ts",
    "tui": "node --conditions=development --import tsx src/cli.ts tui",
    "list": "node --conditions=development --import tsx src/cli.ts list",
    "describe": "node --conditions=development --import tsx src/cli.ts describe",
    "validate": "node --conditions=development --import tsx src/cli.ts validate",
    "run": "node --conditions=development --import tsx src/cli.ts run",
    "grade": "node --conditions=development --import tsx src/cli.ts grade",
    "report": "node --conditions=development --import tsx src/cli.ts report",
    "compare": "node --conditions=development --import tsx src/cli.ts compare",
    "fixtures:generate": "node --conditions=development --import tsx src/cli.ts fixtures generate",
    "fixtures:lint": "node --conditions=development --import tsx src/cli.ts fixtures lint",
    "schemas:export": "node --conditions=development --import tsx src/cli.ts schemas export",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm fixtures:lint && pnpm validate && pnpm build",
    "calibration:pack": "node --conditions=development --import tsx scripts/calibration-pack.ts",
    "review-desk:content": "node scripts/review-desk/publish-content.mjs",
    "review-desk:invite": "node scripts/review-desk/invite.mjs",
    "review-desk:sync": "node scripts/review-desk/sync.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.101",
    "@ai-sdk/openai": "4.0.82",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "ai": "7.0.123",
    "csv-parse": "7.0.3",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "esbuild": "0.28.2",
    "ink": "7.1.1",
    "pg": "8.23.1",
    "postal-mime": "4.0.2",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "uuid": "14.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@vercel/blob": "2.4.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
