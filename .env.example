# Offline authoring commands need no credentials. Configuration loads only
# the explicit file passed with --config; this file is not auto-loaded.
# Candidate config may explicitly name this variable through candidate.apiKeyEnv.
ROYAL_LAB_CANDIDATE_API_KEY=
# Semantic judges are later work; setting a key does not enable judging.
ROYAL_LAB_JUDGE_API_KEY=
# Bridge checkout/database settings are explicit JSON fields in --config.
# No ambient DATABASE_URL or bridge environment variables are loaded.
