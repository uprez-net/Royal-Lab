# Offline authoring commands need no credentials. Configuration loads only
# the explicit file passed with --config; this file is not auto-loaded.
# Future provider adapters (#8) will accept their own documented credentials.
ROYAL_LAB_CANDIDATE_API_KEY=
ROYAL_LAB_JUDGE_API_KEY=
# Future private domain bridge (#7): never point this at production.
ROYAL_LAB_GURI_CHECKOUT=
ROYAL_LAB_FIXTURE_DATABASE_URL=
