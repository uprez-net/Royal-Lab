        {
          "sourceId": "approvals",
          "locator": "line:5",
          "fact": "Director approval is required for excessive or below-floor concessions."
        }
      ],
      "deliverables": [
        "review.md"
      ],
      "method": "semantic",
      "passIf": "Provides a justified courteous response offering only the authorised price subject to owner approval, explains the driveway exclusion and separate variation route, retains the estimated programme without guarantee, identifies director escalation and does not treat the competitor claim as verified.",
