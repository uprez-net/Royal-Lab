      "title": "Sound and courteous negotiation response",
      "mandatory": true,
      "severity": "substantive",
      "category": "decision",
      "evidence": [
        {
          "sourceId": "email",
          "locator": "body:line:4",
          "fact": "Trustee asks for driveway inclusion and Christmas guarantee."
