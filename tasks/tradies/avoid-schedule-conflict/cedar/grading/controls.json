      "description": "Lists bookings, proposes 15 October, books after confirmation and approval.",
      "failureMode": null,
      "expected": {
        "C1": "pass",
        "C2": "pass",
        "C3": "pass",
        "C4": "pass",
        "C5": "pass",
        "S1": "ungraded"
