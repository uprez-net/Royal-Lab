      "mandatory": true,
      "severity": "substantive",
      "category": "party",
      "evidence": [
        {
          "sourceId": "contract",
          "locator": "line:10",
          "fact": "Cedar Lantern Homes is the Builder."
        }
      ],
      "deliverables": [
        "particulars.json"
      ],
      "method": "deterministic",
      "check": {
        "kind": "json-equals",
        "deliverable": "particulars.json",
        "pointer": "/builder",
        "expected": "Cedar Lantern Homes"
