      "category": "money",
      "evidence": [
        {
          "sourceId": "contract",
          "locator": "line:19",
          "fact": "Contract price $664,576.00."
        }
      ],
      "deliverables": [
        "particulars.json",
        "review.md"
      ],
      "method": "deterministic",
      "check": {
        "kind": "json-equals",
        "deliverable": "particulars.json",
        "pointer": "/contractPriceCents",
