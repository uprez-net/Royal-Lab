      ],
      "deliverables": [
        "particulars.json",
        "review.md"
      ],
      "method": "deterministic",
      "check": {
        "kind": "json-equals",
        "deliverable": "particulars.json",
        "pointer": "/contractDate",
        "expected": "2026-09-21"
      }
    },
    {
      "id": "C5",
      "title": "Build period from the contract",
      "mandatory": true,
      "severity": "substantive",
      "category": "date",
      "evidence": [
        {
