    },
    {
      "id": "S1",
      "title": "Explains precedence and corrects the handover",
      "mandatory": true,
      "severity": "substantive",
      "category": "evidence",
      "evidence": [
        {
          "sourceId": "email",
          "locator": "body:line:4",
          "fact": "Handover repeats Lot 41 and 48 weeks."
        },
        {
          "sourceId": "contract",
          "locator": "line:15",
          "fact": "Contract land is Lot 14."
        }
      ],
      "deliverables": [
        "review.md"
      ],
      "method": "semantic",
      "passIf": "Explains that the signed contract governs the lot and build period over the tender and handover email, names both conflicts and does not treat the builder, witness or footer as owners.",
      "failIf": "Adopts tender values for a field the contract states, or omits either conflict."
    }
  ]
