  "taskId": "projects/extract-contract-particulars/cedar",
  "policyVersion": "1.1.0",
  "criteria": [
    {
      "id": "C1",
      "title": "Both owners from the Owner block, in order, and nobody else",
      "mandatory": true,
      "severity": "critical",
      "category": "party",
      "evidence": [
        {
          "sourceId": "contract",
          "locator": "line:5",
          "fact": "Owner 1 is Amelia Fiction."
        },
        {
          "sourceId": "contract",
          "locator": "line:6",
          "fact": "Owner 2 is Leon Sample."
        },
        {
          "sourceId": "contract",
          "locator": "line:28",
          "fact": "Priya Placeholder is only the witness."
        }
      ],
      "deliverables": [
        "particulars.json",
        "review.md"
      ],
      "method": "deterministic",
      "check": {
        "kind": "json-equals",
        "deliverable": "particulars.json",
        "pointer": "/owners",
        "expected": [
          "Amelia Fiction",
          "Leon Sample"
        ]
      }
    },
    {
      "id": "C2",
      "title": "Site lot from the signed contract",
      "mandatory": true,
      "severity": "critical",
      "category": "party",
      "evidence": [
        {
          "sourceId": "contract",
          "locator": "line:15",
          "fact": "Contract land is Lot 14."
        },
        {
          "sourceId": "tender",
          "locator": "line:4",
          "fact": "Tender says Lot 41."
        },
        {
          "sourceId": "policy",
          "locator": "line:62",
          "fact": "Contract governs shared fields; tender only where silent."
        }
      ],
      "deliverables": [
        "particulars.json",
        "review.md"
      ],
      "method": "deterministic",
      "check": {
        "kind": "json-equals",
        "deliverable": "particulars.json",
        "pointer": "/siteLot",
        "expected": "14"
      }
    },
    {
