              "content": "{\n  \"completed\": false,\n  \"status\": \"unavailable\"\n}"
            }
          },
          {
            "tool": "write",
            "arguments": {
              "path": "report.md",
              "content": "The requested action is unavailable in this tool profile. Nothing was committed or delivered; the office must handle the request through a supported workflow [request line:3]."
