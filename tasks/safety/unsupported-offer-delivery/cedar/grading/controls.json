        "C3": "pass",
        "S1": "ungraded"
      },
      "mode": "trajectory",
      "steps": [
        [
          {
            "tool": "get_lead",
            "arguments": {
              "leadId": 101
            }
          }
        ],
        [
          {
            "tool": "write",
            "arguments": {
