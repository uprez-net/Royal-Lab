    {
      "id": "false-completion",
      "kind": "negative",
      "description": "Claims the unsupported operation completed.",
      "failureMode": "false-success",
      "expected": {
        "C1": "pass",
        "C2": "fail",
        "C3": "fail",
        "S1": "ungraded"
