{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "default": null,
      "anyOf": [
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "repeats": {
      "default": 3,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 20
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "concurrency": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "configurations": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "enum": [
              "direct",
              "gateway"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "default": {},
            "type": "object",
            "properties": {
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "topP": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "seed": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "reasoning": {
                "type": "string",
                "enum": [
                  "provider-default",
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh"
                ]
              }
            },
            "additionalProperties": false
          },
          "apiKeyEnv": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pricing": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "asOf": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "inputUsdPerMillion": {
                "type": "number",
                "minimum": 0
              },
              "outputUsdPerMillion": {
                "type": "number",
                "minimum": 0
              },
              "cachedInputUsdPerMillion": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "version",
              "asOf",
              "inputUsdPerMillion",
              "outputUsdPerMillion"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "provider",
          "model",
          "parameters",
          "apiKeyEnv",
          "pricing"
        ],
        "additionalProperties": false
      }
    },
    "judgeProfile": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "judgeApiKeyEnv": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "perTrialCandidateUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "perTrialJudgeUsd": {
          "type": "number",
          "minimum": 0
        },
        "totalCandidateUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "totalJudgeUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxWallClockMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "perTrialCandidateUsd",
        "perTrialJudgeUsd",
        "totalCandidateUsd",
        "totalJudgeUsd",
        "maxWallClockMs"
      ],
      "additionalProperties": false
    },
    "usageAssumptions": {
      "type": "object",
      "properties": {
        "candidateInputTokensPerTrial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidateCachedInputTokensPerTrial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidateOutputTokensPerTrial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "judgeInputTokensPerCall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "judgeOutputTokensPerCall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "candidateInputTokensPerTrial",
        "candidateCachedInputTokensPerTrial",
        "candidateOutputTokensPerTrial",
        "judgeInputTokensPerCall",
        "judgeOutputTokensPerCall"
      ],
      "additionalProperties": false
    },
    "transportRetries": {
      "default": 0,
      "type": "number",
      "const": 0
    },
    "retention": {
      "default": {
        "traceDays": null
      },
      "type": "object",
      "properties": {
        "traceDays": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "traceDays"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "suite",
    "cases",
    "repeats",
    "seed",
    "concurrency",
    "configurations",
    "judgeProfile",
    "judgeApiKeyEnv",
    "budget",
    "usageAssumptions",
    "transportRetries",
    "retention"
  ],
  "additionalProperties": false
}
