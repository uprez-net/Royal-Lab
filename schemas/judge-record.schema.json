{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "judgeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "configurationFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempted": {
      "type": "boolean"
    },
    "rawResponse": {
      "type": [
        "string",
        "null"
      ]
    },
    "responseHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rawVerdict": {
      "type": [
        "string",
        "null"
      ]
    },
    "rawExplanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "operationalError": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "deliverable",
              "source"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "ref",
          "locator",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "costUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "costUsd",
        "durationMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "judgeId",
    "configurationFingerprint",
    "modelHash",
    "evidenceHash",
    "requestHash",
    "attempted",
    "rawResponse",
    "responseHash",
    "rawVerdict",
    "rawExplanation",
    "operationalError",
    "verdict",
    "explanation",
    "evidence",
    "usage"
  ],
  "additionalProperties": false
}
