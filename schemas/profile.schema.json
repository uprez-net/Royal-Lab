{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "enum": [
        "documents",
        "fixed-tools",
        "royal-eve"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "effectPolicy": {
      "type": "string",
      "enum": [
        "none",
        "recording-ports",
        "staging-cancel-only"
      ]
    },
    "candidateNetwork": {
      "type": "boolean",
      "const": false
    },
    "candidateShell": {
      "type": "boolean",
      "const": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxTurns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxToolCalls": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxInputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDurationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "maxTurns",
        "maxToolCalls",
        "maxInputTokens",
        "maxOutputTokens",
        "maxDurationMs",
        "maxCostUsd"
      ],
      "additionalProperties": false
    },
    "executionImplemented": {
      "type": "boolean"
    },
    "guriRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "systemPromptHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parserProfile": {
      "type": "string",
      "enum": [
        "normalized-text",
        "isolated-binary",
        "product-native"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "tools",
    "effectPolicy",
    "candidateNetwork",
    "candidateShell",
    "limits",
    "executionImplemented",
    "guriRevision",
    "systemPromptHash",
    "parserProfile"
  ],
  "additionalProperties": false
}
