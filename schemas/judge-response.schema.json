{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "deliverable",
              "source"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "ref",
          "locator",
          "quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "explanation",
    "evidence"
  ],
  "additionalProperties": false
}
