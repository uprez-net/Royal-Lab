{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "executionEvidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rubricHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deterministicHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "exploratory",
            "release"
          ]
        },
        "scorePolicy": {
          "type": "string",
          "const": "all-mandatory-1.0.0"
        },
        "promptVersion": {
          "type": "string",
          "const": "criterion-1.0.0"
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "approved",
                "rejected"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "reviewedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "reviewer",
            "reviewedAt",
            "notes"
          ],
          "additionalProperties": false
        },
        "calibrationHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxRequests": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 200
            },
            "maxRequestBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "maxOutputTokensPerRequest": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 8000
            },
            "maxInputTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxOutputTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxCostUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "timeoutMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 60000
            },
            "maxDurationMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 600000
            }
          },
          "required": [
            "maxRequests",
            "maxRequestBytes",
            "maxOutputTokensPerRequest",
            "maxInputTokens",
            "maxOutputTokens",
            "maxCostUsd",
            "timeoutMs",
            "maxDurationMs"
          ],
          "additionalProperties": false
        },
        "judges": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "direct",
                  "gateway"
                ]
              },
              "model": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "topP": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "reasoning": {
                    "type": "string",
                    "enum": [
                      "provider-default",
                      "none",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "pricing": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "version": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d+\\.\\d+$"
                      },
                      "asOf": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      },
                      "inputUsdPerMillion": {
                        "type": "number",
                        "minimum": 0
                      },
                      "outputUsdPerMillion": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "version",
                      "asOf",
                      "inputUsdPerMillion",
                      "outputUsdPerMillion"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "transport",
              "model",
              "parameters",
              "pricing"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "purpose",
        "scorePolicy",
        "promptVersion",
        "review",
        "calibrationHash",
        "limits",
        "judges"
      ],
      "additionalProperties": false
    },
    "profileHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "promptHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "nodeVersion": {
          "type": "string",
          "minLength": 1
        },
        "lockfileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sdkVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nodeVersion",
        "lockfileHash",
        "sdkVersion"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "benchmark",
        "calibration",
        "offline-control"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterionId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "scope": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "criterion": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "passIf": {
                        "type": "string",
                        "minLength": 1
                      },
                      "failIf": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "passIf",
                      "failIf"
                    ],
                    "additionalProperties": false
                  },
                  "deliverables": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "path",
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "sources": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "sourceId",
                        "locator",
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "criterion",
                  "deliverables",
                  "sources"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "scopeError": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "judges": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "judgeId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                },
                "configurationFingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "modelHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidenceHash": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "requestHash": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "attempted": {
                  "type": "boolean"
                },
                "rawResponse": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "responseHash": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rawVerdict": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rawExplanation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "operationalError": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail",
                    "error"
                  ]
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "deliverable",
                          "source"
                        ]
                      },
                      "ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "ref",
                      "locator",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                },
                "usage": {
                  "type": "object",
                  "properties": {
                    "inputTokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "outputTokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "costUsd": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "durationMs": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "inputTokens",
                    "outputTokens",
                    "costUsd",
                    "durationMs"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "judgeId",
                "configurationFingerprint",
                "modelHash",
                "evidenceHash",
                "requestHash",
                "attempted",
                "rawResponse",
                "responseHash",
                "rawVerdict",
                "rawExplanation",
                "operationalError",
                "verdict",
                "explanation",
                "evidence",
                "usage"
              ],
              "additionalProperties": false
            }
          },
          "disagreement": {
            "type": "boolean"
          }
        },
        "required": [
          "criterionId",
          "scope",
          "scopeError",
          "judges",
          "disagreement"
        ],
        "additionalProperties": false
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "runId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "taskVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "profile": {
          "type": "string",
          "enum": [
            "documents",
            "fixed-tools",
            "royal-eve"
          ]
        },
        "trial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "excluded",
            "invalid",
            "pending",
            "running",
            "completed",
            "candidate-failure",
            "budget-exhausted",
            "blocked-input",
            "infrastructure-error"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "gradingStatus": {
          "type": "string",
          "enum": [
            "ungraded",
            "graded",
            "judge-error"
          ]
        },
        "strictSuccess": {
          "type": "boolean"
        },
        "criticalGatesPassed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "mandatory": {
                "type": "boolean"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "substantive",
                  "diagnostic"
                ]
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "ungraded"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidencePaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "mandatory",
              "severity",
              "verdict",
              "reason",
              "evidencePaths"
            ],
            "additionalProperties": false
          }
        },
        "outcomeId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "candidateCostUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "judgeCostUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "toolAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "toolExecutions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "committedEffects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "candidateCostUsd",
            "judgeCostUsd",
            "durationMs",
            "toolAttempts",
            "toolExecutions",
            "committedEffects"
          ],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "taskId",
        "taskVersion",
        "profile",
        "trial",
        "status",
        "reason",
        "gradingStatus",
        "strictSuccess",
        "criticalGatesPassed",
        "criteria",
        "outcomeId",
        "usage",
        "artifacts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "runId",
    "taskId",
    "executionEvidenceHash",
    "rubricHash",
    "deterministicHash",
    "profile",
    "profileHash",
    "prompt",
    "promptHash",
    "implementationHash",
    "runtime",
    "mode",
    "criteria",
    "result"
  ],
  "additionalProperties": false
}
