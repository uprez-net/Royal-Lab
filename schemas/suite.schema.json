{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "held-out"
      ]
    },
    "profile": {
      "type": "string",
      "enum": [
        "documents",
        "fixed-tools",
        "royal-eve"
      ]
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "split",
    "profile",
    "cases",
    "description"
  ],
  "additionalProperties": false
}
