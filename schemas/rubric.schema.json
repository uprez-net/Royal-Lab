{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "mandatory": {
                "type": "boolean"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "substantive",
                  "diagnostic"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "money",
                  "date",
                  "party",
                  "evidence",
                  "decision",
                  "approval",
                  "auth",
                  "effect",
                  "replay",
                  "truthfulness",
                  "quality"
                ]
              },
              "deliverables": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fact": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "sourceId",
                    "locator",
                    "fact"
                  ],
                  "additionalProperties": false
                }
              },
              "method": {
                "type": "string",
                "const": "deterministic"
              },
              "check": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "json-equals"
                      },
                      "deliverable": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pointer": {
                        "type": "string",
                        "pattern": "^(\\/([^~]|~[01])*)*$"
                      },
                      "expected": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "kind",
                      "deliverable",
                      "pointer",
                      "expected"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "state-equals"
                      },
                      "entity": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                      },
                      "field": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                      },
                      "expected": {
                        "$ref": "#/$defs/__schema1"
                      }
                    },
                    "required": [
                      "kind",
                      "entity",
                      "field",
                      "expected"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "effect-count"
                      },
                      "effect": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                      },
                      "expected": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "effect",
                      "expected"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "title",
              "mandatory",
              "severity",
              "category",
              "deliverables",
              "evidence",
              "method",
              "check"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "mandatory": {
                "type": "boolean"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "substantive",
                  "diagnostic"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "money",
                  "date",
                  "party",
                  "evidence",
                  "decision",
                  "approval",
                  "auth",
                  "effect",
                  "replay",
                  "truthfulness",
                  "quality"
                ]
              },
              "deliverables": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fact": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "sourceId",
                    "locator",
                    "fact"
                  ],
                  "additionalProperties": false
                }
              },
              "method": {
                "type": "string",
                "const": "semantic"
              },
              "passIf": {
                "type": "string",
                "minLength": 1
              },
              "failIf": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title",
              "mandatory",
              "severity",
              "category",
              "deliverables",
              "evidence",
              "method",
              "passIf",
              "failIf"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "taskId",
    "policyVersion",
    "criteria"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
