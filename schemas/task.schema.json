{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "core",
        "variant",
        "diagnostic"
      ]
    },
    "variantOf": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scenarioVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "definitionId": {
      "type": "string",
      "pattern": "^[DT]\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "workType": {
      "type": "string",
      "enum": [
        "extract",
        "reconcile",
        "analyze",
        "draft",
        "operate",
        "boundary"
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "documents",
          "fixed-tools",
          "royal-eve"
        ]
      }
    },
    "worldId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "clock": {
      "type": "object",
      "properties": {
        "instant": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "timezone": {
          "type": "string",
          "const": "Australia/Sydney"
        }
      },
      "required": [
        "instant",
        "timezone"
      ],
      "additionalProperties": false
    },
    "jurisdiction": {
      "type": "string",
      "const": "AU-NSW"
    },
    "currency": {
      "type": "string",
      "const": "AUD"
    },
    "inputs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "document",
              "policy"
            ]
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "kind",
          "mediaType"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "deliverables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "application/json",
              "text/markdown"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "mediaType",
          "description",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "fixturePath": {
      "type": "string",
      "minLength": 1
    },
    "fixtureHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rubricPath": {
      "type": "string",
      "minLength": 1
    },
    "rubricHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenancePath": {
      "type": "string",
      "minLength": 1
    },
    "provenanceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verificationPath": {
      "type": "string",
      "minLength": 1
    },
    "verificationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controlsPath": {
      "type": "string",
      "minLength": 1
    },
    "controlsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environmentPath": {
      "type": "string",
      "minLength": 1
    },
    "environmentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operatorBranches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "clarification",
              "approval",
              "stale-version",
              "timeout"
            ]
          },
          "response": {
            "type": "string",
            "minLength": 1
          },
          "allowedOutcomeIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            }
          }
        },
        "required": [
          "id",
          "trigger",
          "response",
          "allowedOutcomeIds"
        ],
        "additionalProperties": false
      }
    },
    "allowedOutcomes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxTurns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxToolCalls": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxInputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDurationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "maxTurns",
        "maxToolCalls",
        "maxInputTokens",
        "maxOutputTokens",
        "maxDurationMs",
        "maxCostUsd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "scenarioVersion",
    "id",
    "definitionId",
    "title",
    "family",
    "workType",
    "instruction",
    "profiles",
    "worldId",
    "clock",
    "jurisdiction",
    "currency",
    "inputs",
    "tools",
    "deliverables",
    "fixturePath",
    "fixtureHash",
    "rubricPath",
    "rubricHash",
    "provenancePath",
    "provenanceHash",
    "operatorBranches",
    "allowedOutcomes",
    "limits"
  ],
  "additionalProperties": false
}
