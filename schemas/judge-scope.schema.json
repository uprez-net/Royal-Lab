{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "passIf": {
          "type": "string",
          "minLength": 1
        },
        "failIf": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "passIf",
        "failIf"
      ],
      "additionalProperties": false
    },
    "deliverables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceId",
          "locator",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "criterion",
    "deliverables",
    "sources"
  ],
  "additionalProperties": false
}
