{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "version": {
      "type": "string"
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewedAt",
        "notes"
      ],
      "additionalProperties": false
    },
    "maxUnexpectedQuestions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "clarification",
              "approval",
              "stale-version"
            ]
          },
          "allWords": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyWords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "response": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "approved",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "responderId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "maxUses": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "type",
          "allWords",
          "anyWords",
          "response",
          "decision",
          "responderId",
          "maxUses"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "review",
    "maxUnexpectedQuestions",
    "branches"
  ],
  "additionalProperties": false
}
