{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "held-out"
      ]
    },
    "seed": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "clock": {
      "type": "object",
      "properties": {
        "instant": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "timezone": {
          "type": "string",
          "const": "Australia/Sydney"
        }
      },
      "required": [
        "instant",
        "timezone"
      ],
      "additionalProperties": false
    },
    "jurisdiction": {
      "type": "string",
      "const": "AU-NSW"
    },
    "currency": {
      "type": "string",
      "const": "AUD"
    },
    "entities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "builder",
              "owner",
              "lead",
              "project",
              "offer",
              "tradie",
              "certifier",
              "document",
              "invoice"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "email",
          "address",
          "references"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "object",
      "properties": {
        "directCostCents": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "additionsCents": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "overheadBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "feeBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gstBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contractCents": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "spendCents": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "remainingCostCents": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "invoiceCents": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "paidCents": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "directCostCents",
        "additionsCents",
        "overheadBasisPoints",
        "feeBasisPoints",
        "gstBasisPoints",
        "contractCents",
        "spendCents",
        "remainingCostCents",
        "invoiceCents",
        "paidCents"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "entityId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "condition": {
            "type": "string",
            "enum": [
              "readable",
              "partial-scan",
              "missing",
              "conflicting",
              "superseded"
            ]
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "entityId",
          "condition",
          "revision",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "ambiguity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "entityIds": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            }
          }
        },
        "required": [
          "query",
          "entityIds"
        ],
        "additionalProperties": false
      }
    },
    "versionConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "readVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "currentVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "entityId",
          "readVersion",
          "currentVersion"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewedAt",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "id",
    "split",
    "seed",
    "scenario",
    "clock",
    "jurisdiction",
    "currency",
    "entities",
    "facts",
    "evidence",
    "ambiguity",
    "versionConflicts",
    "review"
  ],
  "additionalProperties": false
}
