{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profileHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewedAt",
        "notes"
      ],
      "additionalProperties": false
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "missing-issue",
              "wrong-amount",
              "alternate-wording",
              "abstention",
              "conditional-approval",
              "false-success",
              "prompt-injection"
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passIf": {
                    "type": "string",
                    "minLength": 1
                  },
                  "failIf": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "title",
                  "passIf",
                  "failIf"
                ],
                "additionalProperties": false
              },
              "deliverables": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "sourceId",
                    "locator",
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "criterion",
              "deliverables",
              "sources"
            ],
            "additionalProperties": false
          },
          "evidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expected": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "approved",
                  "rejected"
                ]
              },
              "reviewer": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewedAt",
              "notes"
            ],
            "additionalProperties": false
          },
          "receiptPath": {
            "type": "string",
            "minLength": 1
          },
          "receiptHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "adjudicationPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "scenario",
          "scope",
          "evidenceHash",
          "expected",
          "review",
          "receiptPath",
          "receiptHash",
          "adjudicationPaths"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "profileHash",
    "review",
    "examples"
  ],
  "additionalProperties": false
}
