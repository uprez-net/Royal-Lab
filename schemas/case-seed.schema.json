{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "rows": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "enum": [
              "User",
              "Customer",
              "Lead",
              "LeadTask",
              "Offer",
              "Envelope",
              "Project",
              "Milestone",
              "CertifierEngagement",
              "ComplianceDocument",
              "File",
              "Tradie",
              "TradieSchedule",
              "Invoice"
            ]
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "table",
          "values"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "rows"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
