{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "rubricVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewedAt",
        "notes"
      ],
      "additionalProperties": false
    },
    "assertions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "prose"
              },
              "criterionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "labels": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "expected": {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ]
              },
              "semantics": {
                "type": "string",
                "enum": [
                  "cents",
                  "integer",
                  "identifier",
                  "date-only",
                  "boolean"
                ]
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "criterionId",
              "path",
              "labels",
              "expected",
              "semantics",
              "required"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "state"
              },
              "criterionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "target": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "historyMinimum": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "historyTarget": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "operationMinimum": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "operationTarget": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "preservePaths": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "criterionId",
              "collection",
              "target",
              "fields",
              "count",
              "preservePaths"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "effects"
              },
              "criterionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "effectKind": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "succeeded": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "forbiddenKinds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                }
              },
              "reportedOutcome": {
                "type": "string",
                "enum": [
                  "sent",
                  "cancelled",
                  "failed",
                  "replayed"
                ]
              },
              "callId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              }
            },
            "required": [
              "kind",
              "criterionId",
              "effectKind",
              "succeeded",
              "forbiddenKinds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "trace"
              },
              "criterionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "forbiddenTools": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                }
              },
              "mutationTools": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                }
              },
              "requiredQuestion": {
                "default": false,
                "type": "boolean"
              },
              "questionBeforeMutation": {
                "default": false,
                "type": "boolean"
              },
              "requiredDecision": {
                "type": "string",
                "enum": [
                  "approved",
                  "cancelled"
                ]
              },
              "allowedDiscoveryRefusals": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                }
              },
              "ownerId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "sessionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              }
            },
            "required": [
              "kind",
              "criterionId",
              "forbiddenTools",
              "mutationTools",
              "requiredQuestion",
              "questionBeforeMutation",
              "allowedDiscoveryRefusals"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "citations"
              },
              "criterionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "criterionId",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "absent"
              },
              "criterionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "values": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 6
                }
              }
            },
            "required": [
              "kind",
              "criterionId",
              "paths",
              "values"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "taskId",
    "rubricVersion",
    "review",
    "assertions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
